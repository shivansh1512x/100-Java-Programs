import java.util.*;
public class p28 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        System.out.println("Enter the value of n:");
        int n = sc.nextInt();

        float fact = 1;

        for(int i = 1; i <= n; i++){
            fact = fact * i;
        }
        System.out.println("The factorial of" + " " + n + " " + "is" + " " + fact);
    }
}
