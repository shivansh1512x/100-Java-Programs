import java.util.*;
public class p29 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        System.out.println("Enter the value of n:");
        int n = sc.nextInt();

        int count = 0;

        for(int i = 1; i <= n; i++){
            if(i % 3 == 0){
                count++;
            }
        }
        System.out.println("The numbers from 1 to" + " " + n + " " + "is divisible by 3:" + " " + count);
    }
}
