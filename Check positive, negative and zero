import java.util.*;
public class p12 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        System.out.println("Enter a number:" + " ");
        int A = sc.nextInt();

        if (A > 0){
            System.out.println(A + " " + "is positive");
        }else if (A < 0){
            System.out.println(A + " " + "is negative");
        }else{
            System.out.println(A + " " + "is zero");
        }
    }
}
