import java.util.*;
public class p11 {
    public static void main(String[] args) {
        Scanner sc =  new Scanner(System.in);

        System.out.println("Enter a number:" + " ");
        int A = sc.nextInt();

        if(A % 2 == 0){
            System.out.println(A + " " + "is an even number.");
        }else{
            System.out.println(A + " " + "is an odd number.");
        }


    }
}
