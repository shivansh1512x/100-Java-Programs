import java.util.Scanner;
public class p34 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.println("Enter the number n: ");
        int n = sc.nextInt();

        while(n > 0){
            int lastDigit = n % 10;
            System.out.println(lastDigit);
            n = n/10;
        }
    }
}
