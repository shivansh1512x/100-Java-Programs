import java.util.*;
public class p22 {
    public static void main(String[] args) {
        Scanner sc =  new Scanner(System.in);

        System.out.println("Enter the value of n: ");
        int n = sc.nextInt();

        System.out.println("Natural numbers from" + " " + n + " " + "down to 1: ");

        for(int i = n; i >= 1; i--){
            System.out.println(i + " ");
        }

    }
}
