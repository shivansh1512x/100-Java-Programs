
import java.util.Scanner;
public class p39 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.println("Enter the number: ");
        int n = sc.nextInt();
        int minDigit = 9;

        while(n>0){
            int lastDigit = n % 10;
            if(minDigit > lastDigit){
                minDigit = lastDigit;

            }
            n = n / 10;
        }
        System.out.println("The smallest digit is:"+ " " + minDigit);
    }
}
